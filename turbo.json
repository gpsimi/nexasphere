{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "VERCEL_URL",
    "NEXT_PUBLIC_API_URL",
    "DASHBOARD_URL",
    "USERS_URL",
    "FINANCE_URL",
    "OPERATIONS_URL",
    "INVENTORY_URL",
    "REPORTS_URL",
    "ANALYTICS_URL",
    "SYSTEM_HEALTH_URL"
  ],
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "out/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
