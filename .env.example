# Database Settings
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexasphere?schema=public"

# Auth Settings
JWT_SECRET="your-jwt-secret-key-at-least-32-chars-long-for-testing"
NEXTAUTH_SECRET="your-nextauth-secret-key-for-nextauth"

# Port Configurations for Shell and Remotes
PORT_SHELL=3000
PORT_DASHBOARD=3001
PORT_USERS=3002
PORT_FINANCE=3003
PORT_OPERATIONS=3004
PORT_INVENTORY=3005
PORT_REPORTS=3006
PORT_ANALYTICS=3007
PORT_SYSTEM_HEALTH=3008

# API Gateway URL
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
